{
  "namespace": "hud",

  // Suppress vanilla top-left HUD chat so JavaChat's C++ renderer draws it in the bottom-left.
  // Keep chat_stack intact so player coordinates and paper doll remain unaffected.
  "chat_panel": {
    "visible": false,
    "ignored": true,
    "size": [0, 0],
    "controls": []
  },

  // Also suppress common third-party server custom chat panels if present below us in the stack.
  "custom_chat_panel": {
    "visible": false,
    "ignored": true,
    "size": [0, 0],
    "controls": []
  }
}
