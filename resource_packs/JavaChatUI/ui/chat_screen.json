{
  "namespace": "chat",

  // Route cleanly between ultra-light JavaChat UI ($jchat_enabled = true) and untouched
  // vanilla Bedrock chat UI ($jchat_enabled = false) for instant /jchat toggle switching.
  "chat_screen@common.base_screen": {
    "close_on_player_hurt": true,
    "send_telemetry": false,
    "$jchat_enabled|default": true,
    "$jchat_font_type|default": "default",
    "$screen_content": "chat.jchat_screen_router",
    "$screen_bg_content": "chat.jchat_bg_router",
    "variables": [
      {
        "requires": "$jchat_enabled",
        "$screen_animations": [],
        "$background_animations": [],
        "$use_loading_bars": false
      }
    ]
  },

  "jchat_screen_router": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "jchat_active@chat.jchat_screen_content": {
          "ignored": "(not $jchat_enabled)"
        }
      },
      {
        "vanilla_active@chat.chat_screen_content": {
          "ignored": "$jchat_enabled"
        }
      }
    ]
  },

  "jchat_bg_router": {
    "type": "panel",
    "size": ["100%", "100%"],
    "controls": [
      {
        "jchat_bg@chat.jchat_background": {
          "ignored": "(not $jchat_enabled)"
        }
      },
      {
        "vanilla_bg@chat.chat_background": {
          "ignored": "$jchat_enabled"
        }
      }
    ]
  },

  // Vanilla Java-style transparent backdrop (no full-screen dimming).
  "jchat_background": {
    "type": "panel",
    "size": ["100%", "100%"]
  },

  // Authentic Java Edition style: plain translucent black bar (0x80000000), no border or accent strip.
  "jchat_input_bg": {
    "type": "image",
    "texture": "textures/ui/White",
    "color": [0.0, 0.0, 0.0],
    "alpha": 0.5,
    "size": ["100%", "100%"]
  },

  "jchat_input_bg_hover": {
    "type": "image",
    "texture": "textures/ui/White",
    "color": [0.0, 0.0, 0.0],
    "alpha": 0.5,
    "size": ["100%", "100%"]
  },

  // Single-Esc close + Java-style 12px bottom input box.
  "jchat_text_edit_box@common.text_edit_box": {
    "anchor_from": "top_left",
    "anchor_to": "top_left",
    "size": ["100%", 12],
    "max_length": "$max_text_edit_length",
    "always_listening": true,
    "$text_box_name": "#message_text_box",
    "$text_edit_box_content_binding_name": "#message_text_box_content",
    "default_focus_precedence": 1,
    "$focus_id": "text_edit_box_focus_id",
    "$focus_override_left": "",
    "$text_box_tts_header": "accessibility.chat.tts.textboxTitle",
    "$text_background_default": "chat.jchat_input_bg",
    "$text_background_hover": "chat.jchat_input_bg_hover",
    "$text_edit_clipping_panel_size": ["100% + 2px", 12],
    "$text_offset": [-1, 0],
    "$text_edit_box_label_offset": [0, 0],
    "$shadow": true,
    "$text_alignment": "left",
    "$place_holder_text": "",
    "bindings": [
      {
        "binding_type": "$text_edit_box_enabled_binding_type",
        "binding_collection_name": "$text_edit_box_grid_collection_name",
        "binding_name": "$text_box_enabled_binding_name",
        "binding_name_override": "#enabled"
      },
      {
        "binding_name": "#text_edit_box_focus_override_up",
        "binding_name_override": "#focus_change_up"
      },
      {
        "binding_name": "#text_edit_box_focus_override_down",
        "binding_name_override": "#focus_change_down"
      }
    ],
    "button_mappings": [
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_select",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": false,
        "handle_deselect": true,
        "mapping_type": "global",
        "consume_event": false
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "button.menu_ok",
        "to_button_id": "$text_edit_box_selected_to_button_id",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "$text_edit_box_deselected_to_button_id",
        "handle_select": false,
        "handle_deselect": true,
        "consume_event": false,
        "mapping_type": "global"
      },
      {
        "to_button_id": "$text_edit_box_hovered_button_id",
        "mapping_type": "pressed"
      },
      {
        "from_button_id": "$text_edit_box_clear_from_button_id",
        "to_button_id": "$text_edit_box_clear_to_button_id",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.menu_autocomplete",
        "to_button_id": "button.chat_autocomplete",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_autocomplete_back",
        "to_button_id": "button.chat_autocomplete_back",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_textedit_up",
        "to_button_id": "button.chat_previous_message",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.menu_textedit_down",
        "to_button_id": "button.chat_next_message",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.controller_select",
        "to_button_id": "button.send",
        "mapping_type": "global",
        "handle_select": false,
        "handle_deselect": false
      },
      {
        "from_button_id": "button.controller_start",
        "to_button_id": "button.send",
        "mapping_type": "global",
        "handle_select": false,
        "handle_deselect": false
      },
      {
        "from_button_id": "button.controller_autocomplete",
        "to_button_id": "button.chat_autocomplete",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.controller_autocomplete_back",
        "to_button_id": "button.chat_autocomplete_back",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.controller_textedit_up",
        "to_button_id": "button.chat_previous_message",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.controller_textedit_down",
        "to_button_id": "button.chat_next_message",
        "handle_select": false,
        "handle_deselect": false,
        "mapping_type": "focused"
      },
      {
        "from_button_id": "button.controller_secondary_select",
        "to_button_id": "button.chat_paste_coordinates",
        "handle_select": true,
        "handle_deselect": false,
        "mapping_type": "global"
      }
    ]
  },

  // Ultra-lightweight JavaChat screen content: ONLY bottom 12px input box + single-Esc close.
  // Suggestions popup & syntax/ghost visuals are rendered natively by C++ AfterUIRenderEvent.
  "jchat_screen_content": {
    "type": "panel",
    "size": ["100%", "100%"],
    "button_mappings": [
      {
        "from_button_id": "button.menu_exit",
        "to_button_id": "button.chat_menu_cancel",
        "mapping_type": "global"
      },
      {
        "from_button_id": "button.menu_cancel",
        "to_button_id": "button.chat_menu_cancel",
        "mapping_type": "global"
      }
    ],
    "controls": [
      {
        "chat_bottom_panel@chat.jchat_bottom_panel": {
          "layer": 2
        }
      }
    ]
  },

  // Authentic Java-style 12px bottom input bar (offset [2, -2], width calc(100% - 4px)).
  "jchat_bottom_panel": {
    "type": "panel",
    "anchor_from": "bottom_left",
    "anchor_to": "bottom_left",
    "offset": [2, -2],
    "size": ["100% - 4px", 12],
    "min_size": ["100% - 4px", 12],
    "controls": [
      {
        "text_box@chat.jchat_text_edit_box": {}
      }
    ]
  }
}
